<head>
	<link rel="stylesheet" href="~/css/site.css" />
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

</head>
@model List<Car>
<html>
<body style=" background-color: #f4f6f9;">

	<div class="d-flex justify-content-center align-items-center "
		 style=" background-color:  #f4f6f9;">

		
		<div class="container text-center">
			<div class="row">
				<div class="row">
					<h1 class="col-3">Booked Cars</h1>
					<div class="col-6"></div>
					<div class="col-3 m-auto">
						<form method="post" action="@Url.Action("Index", "Cars")">
							<button type="submit" class="btn btn-primary">Back To Cars</button>
						</form>
					</div>
				</div>
				@* <h1 class="col-4 offset-4 availableCar">Booked Cars</h1> *@
				@if (Model.Count != 0)
				{
					<table class=" table table-dark table-hover table-striped mt-3">
						<thead>
							<tr>
								<th>Id</th>
								<th>Car Name</th>
								<th>Price/day</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var c in Model)
							{
								<tr>
									<td>@c.Id</td>
									<td>@c.CarName</td>
									<td>@c.PricePerDay</td>
									<td><span class="badge bg-warning">Booked</span></td>
								</tr>
							}
						</tbody>
					</table>
				}
				else
				{
					<div class="alert alert-info">No Booked Cars</div>

				}
				<a href="@Url.Action("Index", "Cars")">View Available Cars</a>
			</div>
		</div>
	</div>
</body>
</html>