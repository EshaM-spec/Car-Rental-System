<head>
	<link rel="stylesheet" href="~/css/site.css" />
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

</head>
@model List<Car>
<html>
<body style=" background-color: #f4f6f9;">
	
	<div class="d-flex justify-content-center align-items-center "
		 style=" background-color:  #f4f6f9;">

		
		<div class="container text-center">
			<div class="row">
				<h1 class="col-4 offset-4 availableCar">Available Cars</h1>
				@if (Model.Count != 0)
					{
						<p>Choose any Car you want to book</p>

						<div class="container text-center ">
						
							<div class="row">
								@foreach (var c in Model)
								{
									<div class="col-3 card me-3">
										<div class="card-body">
											<h2 class="card-title">@c.CarName</h2>
											<p class="card-text">PKR: @c.PricePerDay Per/Day</p>
											<span class="badge bg-success">Available</span>
										</div>
										<div class="card-footer">
											<form method="post" action="@Url.Action("BookCar", "Cars", new { id = c.Id })">
												<button type="submit" class="btn btn-primary">Book Me</button>
											</form>
										</div>
									</div>
								}
							</div>

				</div>
				}
				else
				{
					<div class="alert alert-info">No Available Cars</div>	
				}

				<a href="@Url.Action("Booked", "Cars")">View booked cars</a>
			</div>
		</div>
	</div>


</body>
</html>